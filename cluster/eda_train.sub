# HTCondor submit file for full EDA + training pipeline.
#
# Usage:
#   condor_submit_bid 10 cluster/eda_train.sub
#
# This runs the comprehensive script that does:
#   1. Dataset EDA (gait profiles, distributions, correlations)
#   2. Snapshot model training (PCA, NMF, AE, VAE, MAE)
#   3. Stride model training (StridePCA, StrideNMF, StrideAE, StrideVAE, StrideMAE)
#   4. Comparison plots + best model selection

universe        = vanilla
executable      = /bin/bash
arguments       = "cluster/eda_train.sh"
initialdir      = /lustre/fast/fast/lsivakumar/LEAPS

# Resources — stride training is heavier, give enough memory
request_gpus    = 1
request_cpus    = 4
request_memory  = 24576

# Logs
output          = cluster/logs/eda_train_$(Cluster).out
error           = cluster/logs/eda_train_$(Cluster).err
log             = cluster/logs/eda_train_$(Cluster).log

# Environment — proxy for pip/wandb
getenv          = true

queue
