# HTCondor job for PPO training (latent variant — policy outputs z, frozen decoder maps to muscles)
# Usage: condor_submit_bid 250 cluster/ppo_latent.sub
# Requires: update --decoder-checkpoint to best StrideFlatAE checkpoint from stride_sweep_v2

executable    = /fast/lsivakumar/LEAPS/.venv/bin/python
arguments     = -m leaps.scripts.simulate_walking ppo \
                --variant latent \
                --train \
                --total-timesteps 2000000 \
                --latent-dim 9 \
                --decoder-checkpoint /fast/lsivakumar/LEAPS/experiments/stride_sweep_v2/checkpoints/StrideFlatAE_d9.pkl \
                --output-dir /fast/lsivakumar/LEAPS/experiments/ppo_latent \
                --wandb --wandb-project leaps

output        = /fast/lsivakumar/LEAPS/logs/ppo_latent.out
error         = /fast/lsivakumar/LEAPS/logs/ppo_latent.err
log           = /fast/lsivakumar/LEAPS/logs/ppo_latent.log

request_cpus  = 8
request_memory = 64000
request_gpus  = 1
request_disk  = 10240
requirements  = CUDADeviceName == "NVIDIA H100" || CUDADeviceName == "NVIDIA A100-SXM4-80GB" || CUDADeviceName == "NVIDIA H100 80GB HBM3"

environment   = "MUJOCO_GL=osmesa JAX_PLATFORMS=cpu"

should_transfer_files = no
queue
