# HTCondor submit file for GPU training jobs.
#
# Usage:
#   # Snapshot sweep (all models, all dims)
#   condor_submit_bid 10 cluster/train.sub
#
#   # Stride sweep
#   condor_submit_bid 10 cluster/train.sub job_type=stride
#
#   # Quick test (3 epochs, one model)
#   condor_submit_bid 10 cluster/train.sub extra_args="--models AE --latent-dims 4 --epochs 3"
#
#   # Stride + specific models
#   condor_submit_bid 10 cluster/train.sub job_type=stride extra_args="--models StrideAE StrideVAE --latent-dims 4 6 --epochs 100"

universe        = vanilla
executable      = /bin/bash
arguments       = "cluster/train.sh $(job_type) $(extra_args)"
initialdir      = /lustre/fast/fast/lsivakumar/LEAPS

# Defaults (override on command line)
job_type        = snapshot
extra_args      =

# Resources
request_gpus    = 1
request_cpus    = 4
request_memory  = 16384

# Logs
output          = cluster/logs/train_$(Cluster).out
error           = cluster/logs/train_$(Cluster).err
log             = cluster/logs/train_$(Cluster).log

# Environment — proxy for pip/wandb
getenv          = true

queue
