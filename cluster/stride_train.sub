# HTCondor job for StrideFlatAE training (no sigmoid, v2 sweep)
# Usage: condor_submit_bid 250 cluster/stride_train.sub

executable    = /fast/lsivakumar/LEAPS/.venv/bin/python
arguments     = -m leaps.scripts.train_strides \
                --data /fast/lsivakumar/data/processed/emg_activations.h5 \
                --models StrideFlatAE \
                --latent-dims 4 6 9 \
                --epochs 150 --batch-size 128 \
                --output-dir /fast/lsivakumar/LEAPS/experiments/stride_sweep_v2 \
                --wandb --wandb-project leaps

output        = /fast/lsivakumar/LEAPS/logs/stride_train.out
error         = /fast/lsivakumar/LEAPS/logs/stride_train.err
log           = /fast/lsivakumar/LEAPS/logs/stride_train.log

request_cpus  = 8
request_memory = 64000
request_gpus  = 1
request_disk  = 10240
requirements  = CUDADeviceName == "NVIDIA H100" || CUDADeviceName == "NVIDIA A100-SXM4-80GB" || CUDADeviceName == "NVIDIA H100 80GB HBM3"

environment   = "MUJOCO_GL=osmesa JAX_PLATFORMS=cpu"

should_transfer_files = no
queue
