# HTCondor job for PPO training (direct variant — raw 18-dim muscle actions)
# Usage: condor_submit_bid 250 cluster/ppo_train.sub

executable    = /fast/lsivakumar/LEAPS/.venv/bin/python
arguments     = -m leaps.scripts.simulate_walking ppo \
                --variant direct \
                --train \
                --total-timesteps 2000000 \
                --output-dir /fast/lsivakumar/LEAPS/experiments/ppo_direct \
                --wandb --wandb-project leaps

output        = /fast/lsivakumar/LEAPS/logs/ppo_direct.out
error         = /fast/lsivakumar/LEAPS/logs/ppo_direct.err
log           = /fast/lsivakumar/LEAPS/logs/ppo_direct.log

request_cpus  = 8
request_memory = 64000
request_gpus  = 1
request_disk  = 10240
requirements  = CUDADeviceName == "NVIDIA H100" || CUDADeviceName == "NVIDIA A100-SXM4-80GB" || CUDADeviceName == "NVIDIA H100 80GB HBM3"

environment   = "MUJOCO_GL=osmesa JAX_PLATFORMS=cpu"

should_transfer_files = no
queue
